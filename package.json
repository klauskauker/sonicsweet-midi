{
  "name": "sonicsweet-midi-desktop",
  "version": "0.2.6",
  "private": true,
  "description": "SonicSweet WebRTC to virtual MIDI bridge",
  "main": "src/main.cjs",
  "scripts": {
    "build:renderer": "esbuild src/renderer.js --bundle --platform=browser --outfile=build/renderer.bundle.js",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/*.test.js",
    "dist": "npm run prepare:release && npm run build:renderer && electron-builder --publish never",
    "dist:mac": "npm run prepare:release && npm run build:renderer && electron-builder --mac zip --publish never",
    "dist:mac:x64": "npm run prepare:release && npm run build:renderer && electron-builder --mac zip --x64 --publish never",
    "dist:mac:arm64": "npm run prepare:release && npm run build:renderer && electron-builder --mac zip --arm64 --publish never",
    "dist:win": "npm run prepare:release && npm run build:renderer && electron-builder --win zip --x64 --publish never",
    "check:native": "node scripts/check-native.cjs",
    "prepare:release": "node scripts/collect-notices.cjs"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.9"
  },
  "build": {
    "appId": "de.sonicsweet.midi",
    "productName": "SonicSweet MIDI",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@julusian/midi/prebuilds/**/*",
      "node_modules/@ktamas77/abletonlink/build/Release/*.node"
    ],
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "src/sonicsweet.png",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "src/sonicsweet.png",
      "target": [
        "zip"
      ]
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "release/notices",
        "to": "licenses"
      }
    ]
  },
  "optionalDependencies": {
    "@ktamas77/abletonlink": "1.2.3"
  },
  "overrides": {
    "@ktamas77/abletonlink": {
      "node-addon-api": "8.0.0"
    }
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klauskauker/sonicsweet-midi.git"
  },
  "homepage": "https://github.com/klauskauker/sonicsweet-midi"
}
